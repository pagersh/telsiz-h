</head>
<body>

    <div class="w-full max-w-md h-[95vh] max-h-[720px] flex flex-col gap-1.5 relative overflow-hidden p-1.5">
        
        <!-- ÜST BİLGİ & KANALLAR ÇUBUĞU -->
        <div class="pastel-card rounded-xl px-2.5 py-2 flex flex-col gap-1.5 text-xs z-10">
            <div class="flex justify-between items-center">
                <div class="flex items-center gap-2">
                    <span id="led-indicator" class="w-2.5 h-2.5 rounded-full bg-stone-400"></span>
                    <div class="flex flex-col">
                        <div class="flex items-center gap-1">
                            <span id="my-identity" onclick="copyMyId()" class="font-mono font-bold text-[var(--text-dark)] cursor-pointer" title="ID Kopyala">Yükleniyor...</span>
                        </div>
                        <span id="net-status" class="text-[9px] text-[var(--text-muted)]">ÇEVRİMDIŞI</span>
                    </div>
                </div>
                
                <div class="flex items-center gap-1">
                    <!-- Bildirim Açma / Kapatma -->
                    <button id="notif-toggle-btn" onclick="toggleNotifications()" title="Bildirimleri Aç/Kapat" class="p-1.5 rounded-lg bg-emerald-100 text-emerald-800 transition border border-emerald-300">
                        <i id="notif-icon" class="fa-solid fa-bell text-[11px]"></i>
                    </button>
                    <!-- Mesajları Temizle Butonu -->
                    <button onclick="clearCurrentChannelMessages()" title="Kanal Mesajlarını Temizle" class="p-1.5 rounded-lg bg-white/60 hover:bg-white hover:text-red-500 transition border border-[var(--border-soft)]">
                        <i class="fa-solid fa-trash text-[11px]"></i>
                    </button>
                    <!-- Rehber Butonu -->
                    <button onclick="openContactsBookModal()" title="Kişi Rehberi" class="px-2 py-1 rounded-lg bg-stone-200 hover:bg-stone-300 text-[var(--text-dark)] font-semibold transition border border-stone-300 text-[10px] flex items-center gap-1">
                        <i class="fa-solid fa-address-book text-[10px]"></i> Rehber
                    </button>
                    <!-- Kişi Ekle Butonu -->
                    <button onclick="openAddContactModal()" title="Kişi Ekle" class="px-2 py-1 rounded-lg bg-[var(--pastel-accent)] hover:opacity-90 text-[var(--text-dark)] font-semibold transition border border-emerald-300 text-[10px] flex items-center gap-1">
                        <i class="fa-solid fa-user-plus text-[10px]"></i> Ekle
                    </button>
                </div>
            </div>

            <!-- HIZLI KANAL GEÇİŞİ -->
            <div class="flex items-center justify-between gap-1 bg-white/50 p-1 rounded-lg border border-[var(--border-soft)] overflow-x-auto hide-scrollbar">
                <div class="flex items-center gap-1 overflow-x-auto hide-scrollbar" id="channel-tabs">
                    <!-- Otomatik Genel Afet Kanalı Butonu -->
                    <button onclick="switchToGlobalChannel()" id="tab-GLOBAL_EMERGENCY" class="px-2.5 py-1 rounded-md bg-red-100 text-red-800 font-bold text-[10px] flex items-center gap-1 border border-red-200 transition flex-shrink-0">
                        <i class="fa-solid fa-tower-broadcast"></i> GENEL AFET (SOS)
                    </button>
                </div>
            </div>
        </div>

        <!-- ANA PAGER EKRANI -->
        <div class="pastel-card rounded-2xl p-2.5 flex-1 flex flex-col justify-between gap-2 overflow-hidden relative">
            
            <div class="flex justify-between items-center px-1 py-0.5 border-b border-[var(--border-soft)] text-xs">
                <div class="flex items-center gap-1">
                    <i class="fa-solid fa-shield-halved text-emerald-600"></i>
                    <span id="active-chat-title" class="font-semibold text-[var(--text-dark)]">GENEL AFET FREKANSI</span>
                </div>
                <div class="flex items-center gap-2 font-mono text-[10px] text-[var(--text-muted)]">
                    <span id="net-label">UÇTAN UCA ŞİFRELİ</span>
                </div>
            </div>

            <!-- MESAJ AKIŞ ALANI -->
            <div id="chat-messages" class="flex-1 overflow-y-auto hide-scrollbar flex flex-col gap-2 pr-0.5 justify-end"></div>

            <!-- MESAJ GİRİŞ FORMU -->
            <div class="flex flex-col gap-1 pt-1.5 pb-1 border-t border-[var(--border-soft)]">
                <form id="chat-form" onsubmit="handleFormSubmit(event)" class="flex items-center gap-1.5">
                    <input type="text" id="chat-input" placeholder="Afet mesajınızı yazın..." autocomplete="off"
                           class="flex-1 bg-white border border-[var(--border-soft)] rounded-xl py-2 px-3 text-xs text-[var(--text-dark)] placeholder-[var(--text-muted)] focus:outline-none focus:ring-1 focus:ring-[var(--pastel-accent)] transition shadow-xs" />
                    
                    <button type="submit" class="w-9 h-9 rounded-xl bg-[var(--pastel-accent)] hover:opacity-90 text-[var(--text-dark)] flex items-center justify-center transition active:scale-95 flex-shrink-0 shadow-sm">
                        <i class="fa-solid fa-paper-plane text-xs"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- KİŞİ EKLEME MODALI -->
    <div id="contact-modal" class="fixed inset-0 bg-black/30 backdrop-blur-xs hidden items-center justify-center z-50 p-4">
        <div class="pastel-card rounded-2xl p-4 w-full max-w-xs flex flex-col gap-3 shadow-xl">
            <div class="flex justify-between items-center">
                <span class="font-bold text-xs">Arkadaşını Rehbere Ekle</span>
                <button onclick="closeAddContactModal()" class="text-stone-400 hover:text-stone-700"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="flex flex-col gap-1 text-[11px]">
                <span class="text-[var(--text-muted)]">Arkadaşının 4 haneli ID'sini girin:</span>
                <input type="text" id="friend-id-input" placeholder="Örn: A8F2" maxlength="4" class="bg-white border border-[var(--border-soft)] rounded-lg p-2 font-mono uppercase focus:outline-none focus:ring-1 focus:ring-[var(--pastel-accent)]" />
                <input type="text" id="friend-name-input" placeholder="İsim / Lakap (İsteğe bağlı)" class="bg-white border border-[var(--border-soft)] rounded-lg p-2 focus:outline-none focus:ring-1 focus:ring-[var(--pastel-accent)] mt-1" />
            </div>
            <button onclick="saveContact()" class="w-full py-2 bg-[var(--pastel-accent)] font-semibold rounded-lg text-xs hover:opacity-90 transition">Rehbere Kaydet ve Bağlan</button>
        </div>
    </div>

    <!-- KİŞİ REHBERİ VE ARAMA MODALI -->
    <div id="contacts-book-modal" class="fixed inset-0 bg-black/30 backdrop-blur-xs hidden items-center justify-center z-50 p-4">
        <div class="pastel-card rounded-2xl p-4 w-full max-w-sm flex flex-col gap-3 shadow-xl max-h-[85vh] overflow-hidden">
            <div class="flex justify-between items-center border-b border-[var(--border-soft)] pb-2">
                <span class="font-bold text-xs flex items-center gap-1.5"><i class="fa-solid fa-address-book text-emerald-700"></i> Kişi Rehberi</span>
                <button onclick="closeContactsBookModal()" class="text-stone-400 hover:text-stone-700"><i class="fa-solid fa-xmark"></i></button>
            </div>
            
            <!-- Canlı Arama / Filtreleme Kutusu -->
            <div class="relative">
                <i class="fa-solid fa-search absolute left-2.5 top-2.5 text-[10px] text-[var(--text-muted)]"></i>
                <input type="text" id="contact-search-input" oninput="filterContactsList(this.value)" placeholder="İsim veya ID ile ara..." class="w-full bg-white border border-[var(--border-soft)] rounded-lg py-1.5 pl-7 pr-2 text-xs focus:outline-none focus:ring-1 focus:ring-[var(--pastel-accent)]" />
            </div>

            <!-- Kişi Listesi Alanı -->
            <div id="contacts-list-container" class="flex-1 overflow-y-auto flex flex-col gap-1.5 max-h-[50vh] hide-scrollbar pr-1">
                <!-- Javascript ile doldurulur -->
            </div>

            <button onclick="closeContactsBookModal(); openAddContactModal();" class="w-full py-2 bg-[var(--pastel-accent)] font-semibold rounded-lg text-xs hover:opacity-90 transition flex items-center justify-center gap-1">
                <i class="fa-solid fa-user-plus"></i> Yeni Kişi Ekle
            </button>
        </div>
    </div>

    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyCbUororrfe0QulrSrxaWONdOhkHaTtIBs",
            authDomain: "pagertrk.firebaseapp.com",
            databaseURL: "https://pagertrk-default-rtdb.firebaseio.com",
            projectId: "pagertrk",
            storageBucket: "pagertrk.firebasestorage.app",
            messagingSenderId: "151073272542",
            appId: "1:151073272542:web:7ef74267da5bf3f128884f",
            measurementId: "G-3X4R8ST9PM"
        };

        firebase.initializeApp(firebaseConfig);
        const db = firebase.database();

        let currentChannel = "GLOBAL_EMERGENCY"; 
        let activeListenerRef = null;
        let soundEnabled = true;
        let notificationsActive = true; 
        
        let myIdShort = localStorage.getItem('pager_my_id');
        if (!myIdShort) {
            myIdShort = Math.random().toString(36).substring(2, 6).toUpperCase();
            localStorage.setItem('pager_my_id', myIdShort);
        }

        let contacts = JSON.parse(localStorage.getItem('pager_contacts') || '{}');
        let audioCtx = null;

        function initAudio() {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            if (audioCtx.state === 'suspended') audioCtx.resume();
        }

        function playPagerAlert() {
            if (!soundEnabled) return;
            initAudio();
            try {
                const now = audioCtx.currentTime;
                [0, 0.12, 0.24].forEach(offset => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'square';
                    osc.frequency.setValueAtTime(2000, now + offset);
                    gain.gain.setValueAtTime(0.06, now + offset);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + offset + 0.06);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(now + offset);
                    osc.stop(now + offset + 0.06);
                });
            } catch (e) {}
        }

        function toggleNotifications() {
            initAudio();
            if ('Notification' in window) {
                if (Notification.permission === 'granted') {
                    notificationsActive = !notificationsActive;
                    updateNotificationButtonUI();
                } else {
                    Notification.requestPermission().then(permission => {
                        if (permission === 'granted') {
                            notificationsActive = true;
                            updateNotificationButtonUI();
                        } else {
                            notificationsActive = false;
                            updateNotificationButtonUI();
                        }
                    });
                }
            }
        }

        function updateNotificationButtonUI() {
            const btn = document.getElementById('notif-toggle-btn');
            const icon = document.getElementById('notif-icon');
            if (notificationsActive) {
                btn.className = "p-1.5 rounded-lg bg-emerald-100 text-emerald-800 transition border border-emerald-300";
                icon.className = "fa-solid fa-bell text-[11px]";
            } else {
                btn.className = "p-1.5 rounded-lg bg-stone-200 text-stone-500 transition border border-stone-300";
                icon.className = "fa-solid fa-bell-slash text-[11px]";
            }
        }

        function triggerSystemNotification(title, bodyText) {
            if (!notificationsActive) return; 
            if ('Notification' in window && Notification.permission === 'granted') {
                new Notification(title, { body: bodyText, icon: 'https://cdn-icons-png.flaticon.com/512/3602/3602145.png' });
            }
        }

        function copyMyId() { 
            navigator.clipboard.writeText(myIdShort).then(() => alert(`Kendi Afet ID'niz kopyalandı: ${myIdShort}\n(Bu ID'yi arkadaşınıza verin)`)); 
        }

        // --- MESAJLARI TEMİZLEME İŞLEVİ ---
        function clearCurrentChannelMessages() {
            initAudio();
            const channelNameDisplay = currentChannel === "GLOBAL_EMERGENCY" ? "Genel Afet Kanalı" : "Bu Özel Hat";
            if (confirm(`${channelNameDisplay} içerisindeki TÜM mesajlar silinecektir. Onaylıyor musunuz?`)) {
                db.ref(`messages_${currentChannel}`).remove().then(() => {
                    document.getElementById('chat-messages').innerHTML = '';
                });
            }
        }

        // --- UÇTAN UCA ŞİFRELEME (E2EE) ---
        function encryptText(text, key) {
            let result = '';
            for (let i = 0; i < text.length; i++) {
                result += String.fromCharCode(text.charCodeAt(i) ^ key.charCodeAt(i % key.length));
            }
            return btoa(unescape(encodeURIComponent(result)));
        }

        function decryptText(cipherText, key) {
            try {
                let decoded = decodeURIComponent(escape(atob(cipherText)));
                let result = '';
                for (let i = 0; i < decoded.length; i++) {
                    result += String.fromCharCode(decoded.charCodeAt(i) ^ key.charCodeAt(i % key.length));
                }
                return result;
            } catch (e) {
                return "[Şifreli Veri]";
            }
        }

        // --- REHBER & KİŞİ YÖNETİMİ ---
        function openAddContactModal() {
            initAudio();
            document.getElementById('contact-modal').style.display = 'flex';
        }

        function closeAddContactModal() {
            document.getElementById('contact-modal').style.display = 'none';
        }

        function openContactsBookModal() {
            initAudio();
            document.getElementById('contacts-book-modal').style.display = 'flex';
            document.getElementById('contact-search-input').value = '';
            renderContactsList();
        }

        function closeContactsBookModal() {
            document.getElementById('contacts-book-modal').style.display = 'none';
        }

        function saveContact() {
            const idInput = document.getElementById('friend-id-input').value.trim().toUpperCase();
            const nameInput = document.getElementById('friend-name-input').value.trim() || idInput;
            
            if (idInput.length !== 4) {
                alert("Lütfen 4 haneli geçerli bir ID girin.");
                return;
            }
            if (idInput === myIdShort) {
                alert("Kendinizi rehbere ekleyemezsiniz.");
                return;
            }

            contacts[idInput] = nameInput;
            localStorage.setItem('pager_contacts', JSON.stringify(contacts));
            
            closeAddContactModal();
            document.getElementById('friend-id-input').value = '';
            document.getElementById('friend-name-input').value = '';
            
            renderContactTabs();
            switchChannel(`dm_${getDmKey(myIdShort, idInput)}`, nameInput, idInput);
        }

        function deleteContact(friendId, event) {
            event.stopPropagation();
            if (confirm(`"${contacts[friendId]}" kişisini rehberden silmek istediğinize emin misiniz?`)) {
                delete contacts[friendId];
                localStorage.setItem('pager_contacts', JSON.stringify(contacts));
                renderContactTabs();
                renderContactsList();
                
                if (currentChannel.includes(friendId)) {
                    switchToGlobalChannel();
                }
            }
        }

        function renderContactsList(filterQuery = '') {
            const container = document.getElementById('contacts-list-container');
            let html = '';
            
            const entries = Object.entries(contacts);
            if (entries.length === 0) {
                container.innerHTML = `<div class="text-center text-[var(--text-muted)] py-4 text-[11px]">Rehberinizde henüz kayıtlı kişi yok.</div>`;
                return;
            }

            const query = filterQuery.toLowerCase();

            let count = 0;
            for (const [friendId, friendName] of entries) {
                if (query && !friendName.toLowerCase().includes(query) && !friendId.toLowerCase().includes(query)) {
                    continue;
                }
                count++;

                html += `
                    <div onclick="closeContactsBookModal(); switchChannel('dm_${getDmKey(myIdShort, friendId)}', '${friendName}', '${friendId}')" 
                         class="flex items-center justify-between p-2 rounded-xl bg-white border border-[var(--border-soft)] hover:bg-stone-50 cursor-pointer transition">
                        <div class="flex items-center gap-2">
                            <div class="w-7 h-7 rounded-lg bg-[var(--pastel-accent)] flex items-center justify-center font-bold text-[10px]">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <div class="flex flex-col">
                                <span class="font-bold text-xs">${friendName}</span>
                                <span class="font-mono text-[9px] text-[var(--text-muted)]">ID: ${friendId}</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-1">
                            <button onclick="deleteContact('${friendId}', event)" title="Kişiyi Sil" class="p-1.5 rounded-lg text-stone-400 hover:text-red-500 hover:bg-red-50 transition">
                                <i class="fa-solid fa-trash text-xs"></i>
                            </button>
                        </div>
                    </div>
                `;
            }

            if (count === 0) {
                html = `<div class="text-center text-[var(--text-muted)] py-4 text-[11px]">Aradığınız kritere uygun kişi bulunamadı.</div>`;
            }

            container.innerHTML = html;
        }

        function filterContactsList(val) {
            renderContactsList(val);
        }

        function getDmKey(id1, id2) {
            return [id1, id2].sort().join('_');
        }

        function renderContactTabs() {
            const container = document.getElementById('channel-tabs');
            let html = `
                <button onclick="switchToGlobalChannel()" id="tab-GLOBAL_EMERGENCY" class="px-2.5 py-1 rounded-md ${currentChannel === 'GLOBAL_EMERGENCY' ? 'bg-red-200 text-red-900 border-red-300' : 'bg-red-50 text-red-700 border-red-200'} font-bold text-[10px] flex items-center gap-1 border transition flex-shrink-0">
                    <i class="fa-solid fa-tower-broadcast"></i> GENEL AFET (SOS)
                </button>
            `;

            for (const [friendId, friendName] of Object.entries(contacts)) {
                const channelKey = `dm_${getDmKey(myIdShort, friendId)}`;
                const isActive = currentChannel === channelKey;
                html += `
                    <button onclick="switchChannel('${channelKey}', '${friendName}', '${friendId}')" id="tab-${channelKey}" class="px-2.5 py-1 rounded-md ${isActive ? 'bg-[var(--pastel-accent)] text-[var(--text-dark)] font-bold' : 'bg-white/80 text-[var(--text-dark)]'} text-[10px] flex items-center gap-1 border border-[var(--border-soft)] transition flex-shrink-0">
                        <i class="fa-solid fa-user text-[9px]"></i> ${friendName}
                    </button>
                `;
            }
            container.innerHTML = html;
        }

        function switchToGlobalChannel() {
            initAudio();
            currentChannel = "GLOBAL_EMERGENCY";
            document.getElementById('active-chat-title').innerText = "GENEL AFET FREKANSI (SOS)";
            renderContactTabs();
            switchChannelListener("messages_GLOBAL_EMERGENCY", "GLOBAL_EMERGENCY");
        }

        function switchChannel(channelKey, titleName, friendId) {
            initAudio();
            currentChannel = channelKey;
            window.activeTargetFriend = friendId; 
            document.getElementById('active-chat-title').innerText = titleName ? `ÖZEL HAT: ${titleName}` : "ÖZEL HAT";
            renderContactTabs();
            switchChannelListener(`messages_${channelKey}`, channelKey);
        }

        function switchChannelListener(firebasePath, encryptionKey) {
            document.getElementById('chat-messages').innerHTML = '';
            if (activeListenerRef) activeListenerRef.off();

            activeListenerRef = db.ref(firebasePath);
            activeListenerRef.on('child_added', (snapshot) => {
                const msg = snapshot.val();
                renderMessage(msg, encryptionKey);
                
                if (msg.sender !== myIdShort) {
                    playPagerAlert();
                    const decryptedText = decryptText(msg.encryptedText, encryptionKey);
                    triggerSystemNotification(`PAGER // ${msg.sender}`, decryptedText);
                }
            });
        }

        function handleFormSubmit(e) {
            e.preventDefault();
            initAudio();
            const input = document.getElementById('chat-input');
            const text = input.value.trim();
            if (!text) return;

            const encrypted = encryptText(text, currentChannel);

            const msgObj = {
                id: 'msg_' + Date.now(),
                sender: myIdShort,
                encryptedText: encrypted,
                time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
            };

            db.ref(`messages_${currentChannel}`).push(msgObj);

            if (currentChannel !== "GLOBAL_EMERGENCY" && window.activeTargetFriend) {
                db.ref(`inbox_${window.activeTargetFriend}`).push({
                    from: myIdShort,
                    channel: currentChannel,
                    preview: text.substring(0, 30),
                    time: msgObj.time
                });
            }

            input.value = '';
        }

        function renderMessage(m, encryptionKey) {
            const container = document.getElementById('chat-messages');
            const isMe = m.sender === myIdShort;
            const decryptedText = decryptText(m.encryptedText, encryptionKey);
            
            const msgEl = document.createElement('div');
            msgEl.className = `flex flex-col gap-0.5 max-w-[85%] ${isMe ? 'self-end items-end' : 'self-start items-start'}`;
            msgEl.innerHTML = `
                <div class="text-[9px] text-[var(--text-muted)] px-1 font-mono"><b>${m.sender}</b> ${m.time}</div>
                <div class="px-3 py-2 rounded-xl text-xs shadow-xs border border-[var(--border-soft)] ${isMe ? 'bg-[var(--pastel-accent)] rounded-tr-none' : 'bg-white rounded-tl-none'}">
                    ${decryptedText}
                </div>
            `;
            container.appendChild(msgEl);
            container.scrollTop = container.scrollHeight;
        }

        function initBackgroundPager() {
            db.ref(`inbox_${myIdShort}`).on('child_added', (snapshot) => {
                const data = snapshot.val();
                if (!data || data.from === myIdShort) return;

                playPagerAlert();
                triggerSystemNotification(`YENİ ÇAĞRI [${data.from}]`, data.preview || "Özel mesaj alındı.");
            });
        }

        window.onload = () => {
            document.getElementById('my-identity').innerText = `ID: ${myIdShort}`;
            const led = document.getElementById('led-indicator');
            const netStatus = document.getElementById('net-status');
            
            led.className = "w-2.5 h-2.5 rounded-full bg-[var(--pastel-accent)] animate-pulse";
            netStatus.innerText = "SİNYAL AKTİF";

            // Service Worker Kaydı Eklendi
            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.register('sw.js')
                    .then(reg => console.log('Service Worker Kaydedildi:', reg))
                    .catch(err => console.error('Service Worker Kayıt Hatası:', err));
            }

            if ('Notification' in window && Notification.permission === 'default') {
                Notification.requestPermission();
            }

            document.body.addEventListener('click', () => initAudio(), { once: true });
            
            initBackgroundPager();
            renderContactTabs();
            switchToGlobalChannel();
        };
    </script>
</body>
</html>